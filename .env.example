APP_NAME=graphgpt-memory-service
APP_ENV=production
DEBUG=false
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=memory-service-consumers
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000

KAFKA_SUMMARY_TOPIC=memory.summary.request
KAFKA_FACT_TOPIC=memory.fact.request
KAFKA_EMBEDDING_TOPIC=memory.embedding.request
KAFKA_DELETE_TOPIC=memory.delete.request
KAFKA_DLQ_TOPIC=memory.dlq

# ─── Cassandra (Primary Source of Truth) ──────────────────────────────────────
# Comma-separated for multi-node: CASSANDRA_HOSTS=10.0.0.1,10.0.0.2,10.0.0.3
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=graphgpt_memory
CASSANDRA_TIMEOUT_SECONDS=5.0

# ─── Redis (Hot Cache Only) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SNAPSHOT_TTL_SECONDS=2592000
SHORT_TERM_MESSAGE_LIMIT=20
IDEMPOTENCY_TTL_SECONDS=604800
REDIS_LOCK_TTL_SECONDS=5
REDIS_LOCK_WATCHDOG_INTERVAL=2.0

# ─── Milvus (Vector Index) ─────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
VECTOR_DIMENSION=1536
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL_VERSION=v1.0.0
MILVUS_BULK_INSERT_BATCH_SIZE=100

# ─── gRPC (LLM Service) ────────────────────────────────────────────────────────
LLM_SERVICE_HOST=localhost
LLM_SERVICE_PORT=50051
GRPC_POOL_SIZE=5
GRPC_TIMEOUT_SECONDS=5.0
GRPC_HEALTH_CHECK_INTERVAL_SECONDS=30.0

# ─── Graph Service ─────────────────────────────────────────────────────────────
GRAPH_SERVICE_URL=http://localhost:8001
GRAPH_SERVICE_TIMEOUT_MS=200

# ─── Outbox Worker ─────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_STALE_PROCESSING_MINUTES=5

# ─── Circuit Breaker ───────────────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SECONDS=60.0
CB_HALF_OPEN_LIMIT=2

# ─── Retrieval Scoring ─────────────────────────────────────────────────────────
RETRIEVAL_WEIGHT_SIMILARITY=0.5
RETRIEVAL_WEIGHT_RECENCY=0.2
RETRIEVAL_WEIGHT_IMPORTANCE=0.3
RETRIEVAL_DECAY_RATE=0.05
RETRIEVAL_TOP_K_FACTS=10
FACT_MERGE_SIMILARITY_THRESHOLD=0.85
